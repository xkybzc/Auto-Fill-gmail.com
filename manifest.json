{
    "manifest_version": 3,
    "name": "Gmail Auto-Fill Domain",
    "version": "1.0",
    "description": "Automatically appends gmail.com when typing @ in email fields.",
    "content_scripts": [
        {
        "matches": [
            "https://*/*",
            "http://*/*",
            "file:///*/tests/*"
        ],
        "js": ["content.js"],
        "all_frames": true,
        "match_about_blank": true
        }
    ]
}
